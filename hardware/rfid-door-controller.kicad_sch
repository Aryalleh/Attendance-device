	(text "Module pin order: SDA SCK MOSI MISO IRQ GND RST 3.3V.\n3.3 V ONLY -- from the D1 mini's regulator (~26 mA).\nIRQ unused. Plug the module in, or run a cable <= 20 cm."
		(exclude_from_sim no)
		(at 284.48 72.39 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "43e8a57b-2c05-54cf-ba12-1e1ba130f12f")
	)
	(text "Active HIGH. (3.3 V - 2.0 V) / 220 = ~6 mA.\n5 mm LEDs: mount on the front, or bend\nthe legs through the enclosure."
		(exclude_from_sim no)
		(at 364.49 82.55 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "501da177-72a0-59ed-8318-a59d7872e684")
	)
