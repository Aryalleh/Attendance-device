	(text "Plugs into two 1x8 female headers. Powered from its micro-USB\nsocket (5 V, >= 500 mA). Total draw < 400 mA.\nBoot straps: D3/GPIO0 and D4/GPIO2 HIGH, D8/GPIO15 LOW at reset.\nThe 47k base resistor leaves D3 at ~2.8 V (VIH 2.5 V).\nC2: bulk for buzzer and relay-module switching."
		(exclude_from_sim no)
		(at 45.72 142.24 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "14e727a1-3024-5cc3-aa55-ee64e21cd00a")
	)
	(text "OPTIONAL RELAY MODULE"
		(exclude_from_sim no)
		(at 38.1 170.055 0)
		(effects
			(font
				(size 1.6 1.6)
				(bold yes)
			)
			(justify left)
		)
		(uuid "2c220aa7-1838-55ce-a8e5-d33766e846c6")
	)
	(text "Active HIGH. (3.3 V - 2.0 V) / 220 = ~6 mA.\n5 mm LEDs: long leg (anode) toward the resistor."
		(exclude_from_sim no)
		(at 237.49 110.49 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "44c85c07-5dbd-539f-b7ac-1bf77e03a202")
	)
	(text "1 VCC  2 GND  3 IN, for an active-LOW 5 V relay module\n(RELAY_ACTIVE_LOW true). D4 is HIGH at boot: relay off.\nGive the lock its OWN supply -- never the USB 5 V --\nand fit a flyback diode across the lock coil."
		(exclude_from_sim no)
		(at 43.18 204.47 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "521848d9-ae1c-568e-b2d2-d585d2e08c2c")
	)
	(text "STATUS LEDS"
		(exclude_from_sim no)
		(at 221.3933 57.535 0)
		(effects
			(font
				(size 1.6 1.6)
				(bold yes)
			)
			(justify left)
		)
		(uuid "5cc019c1-4047-54da-b905-7e2d7500b7d0")
	)
	(text "Module pin order: SDA SCK MOSI MISO IRQ GND RST 3.3V.\n3.3 V ONLY -- from the D1 mini's regulator (~26 mA).\nIRQ unused. Plug the module in, or run a cable <= 15 cm."
		(exclude_from_sim no)
		(at 157.48 110.49 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "60e20088-e50a-516b-8e4e-9f03d53d19f5")
	)
	(text "RC522 RFID READER"
		(exclude_from_sim no)
		(at 134.5183 57.025 0)
		(effects
			(font
				(size 1.6 1.6)
				(bold yes)
			)
			(justify left)
		)
		(uuid "96b95bff-1fd6-59c4-be63-b17314bc3a4c")
	)
	(text "WEMOS D1 MINI (ESP8266) -- USB POWER"
		(exclude_from_sim no)
		(at 38.354 57.025 0)
		(effects
			(font
				(size 1.6 1.6)
				(bold yes)
			)
			(justify left)
		)
		(uuid "9eef7898-7d37-5dc4-a251-297fc6dc056e")
	)
	(text "D3 HIGH (boot, idle): Q1 on, Q2 off, silent.\nD3 LOW: buzzer on. Firmware BUZZER_ACTIVE_LOW true.\nBZ1: 5 V ACTIVE buzzer (beeps on DC), + pin to +5V."
		(exclude_from_sim no)
		(at 307.34 109.22 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "b4cfed11-dd6b-517d-9f04-dbe99d3b5abe")
	)
