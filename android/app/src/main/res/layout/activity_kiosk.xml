<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kiosk_bg"
    android:keepScreenOn="true">

    <!-- The server's live screen for this door (/kiosk/<token>) -->
    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/kiosk_bg"
        android:visibility="invisible" />

    <!-- Built-in screen, used while the server page can't be loaded -->
    <LinearLayout
        android:id="@+id/nativeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/doorName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/kiosk_muted"
            android:textSize="20sp" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:format12Hour="HH:mm:ss"
            android:format24Hour="HH:mm:ss"
            android:textColor="@color/kiosk_text"
            android:textSize="48sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="144dp"
            android:layout_height="144dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_idle_ring"
            android:contentDescription="@null"
            android:padding="36dp"
            android:src="@drawable/ic_result_card"
            android:tint="@color/kiosk_brand_soft" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/ready"
            android:textAlignment="center"
            android:textColor="@color/kiosk_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nativeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/connecting"
            android:textAlignment="center"
            android:textColor="@color/kiosk_muted"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Result of a scan decided on the phone (server unreachable) -->
    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/kiosk_bg"
        android:clickable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ovIcon"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:contentDescription="@null"
            android:padding="40dp" />

        <TextView
            android:id="@+id/ovTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textAlignment="center"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ovName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAlignment="center"
            android:textColor="@color/kiosk_text"
            android:textSize="54sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ovSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAlignment="center"
            android:textColor="@color/kiosk_muted"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Problems (NFC off, server offline) -->
    <TextView
        android:id="@+id/banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="100dp"
        android:background="@drawable/bg_banner"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textColor="@color/kiosk_warn_text"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- Hidden admin corner: tap 5 times quickly to open the settings (PIN protected) -->
    <View
        android:id="@+id/adminCorner"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="top|right" />
</FrameLayout>
